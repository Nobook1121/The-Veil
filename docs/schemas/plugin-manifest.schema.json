{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://the-veil.local/schemas/plugin-manifest.schema.json",
  "title": "The Veil 插件清单",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "version",
    "name"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(\\d+)\\.(\\d+)\\.(\\d+)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "api_version": {
      "const": 1
    },
    "requires": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "description": "目标 App 版本区间，如 >=1.0.0 <2.0.0"
        },
        "plugins": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,63}$"
      },
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,63}$"
      },
      "uniqueItems": true
    },
    "code": {
      "type": "object",
      "required": [
        "entry"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._\\-/]+$",
          "description": "插件内的相对路径；不允许绝对路径、盘符或 .."
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prop_templates": {
          "type": "object",
          "properties": {
            "dirs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9._\\-/]+$",
                "description": "插件内的相对路径；不允许绝对路径、盘符或 .."
              }
            }
          },
          "additionalProperties": false
        },
        "rulesets": {
          "type": "object",
          "required": [
            "module"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9._\\-/]+$",
              "description": "插件内的相对路径；不允许绝对路径、盘符或 .."
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,63}$"
              }
            }
          },
          "additionalProperties": false
        },
        "agent_tools": {
          "type": "object",
          "required": [
            "module",
            "tools"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9._\\-/]+$",
              "description": "插件内的相对路径；不允许绝对路径、盘符或 .."
            },
            "tools": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9_]+$"
              }
            }
          },
          "additionalProperties": false
        },
        "http_blueprints": {
          "type": "object",
          "required": [
            "module",
            "blueprints"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9._\\-/]+$",
              "description": "插件内的相对路径；不允许绝对路径、盘符或 .."
            },
            "blueprints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "settings_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,31}$"
              },
              "title": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "frontend_assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9._\\-/]+$",
                "description": "插件内的相对路径；不允许绝对路径、盘符或 .."
              },
              "type": {
                "enum": [
                  "script",
                  "style",
                  "image",
                  "font"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "ui": {
          "type": "object",
          "required": [
            "api_version"
          ],
          "properties": {
            "api_version": {
              "const": 1
            },
            "workspace": {
              "type": "object",
              "properties": {
                "layout_id": {
                  "type": "string"
                },
                "rulesets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "primary": {
                  "enum": [
                    "canvas",
                    "conversation",
                    "custom"
                  ]
                },
                "primary_min_width": {
                  "type": "integer"
                },
                "sidebar": {
                  "type": "object",
                  "properties": {
                    "position": {
                      "enum": [
                        "left",
                        "none",
                        "right"
                      ]
                    },
                    "width": {
                      "type": "integer"
                    },
                    "min_width": {
                      "type": "integer"
                    },
                    "max_width": {
                      "type": "integer"
                    },
                    "collapsible": {
                      "type": "boolean"
                    },
                    "collapsed_width": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": true
                },
                "topbar": {
                  "type": "object",
                  "properties": {
                    "height": {
                      "type": "integer"
                    },
                    "slots": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "layout",
                          "players",
                          "scene",
                          "settings",
                          "status",
                          "turn"
                        ]
                      }
                    }
                  },
                  "additionalProperties": true
                },
                "left_rail": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "integer"
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                },
                "panels": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      "drawer",
                      "inline",
                      "none",
                      "overlay",
                      "primary",
                      "sidebar",
                      "topbar"
                    ]
                  }
                },
                "priority": {
                  "type": "integer"
                }
              },
              "additionalProperties": true
            },
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "slot"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "slot": {
                    "enum": [
                      "character.sheet.side",
                      "room.chat.aboveHistory",
                      "room.rail.right",
                      "room.stage.primary",
                      "room.tab",
                      "settings.section"
                    ]
                  },
                  "title_i18n": {
                    "type": "string"
                  },
                  "rulesets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "requires": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "priority": {
                    "type": "integer"
                  },
                  "layout": {
                    "type": "object"
                  },
                  "permissions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "mount": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            },
            "sandbox": {
              "type": "object",
              "properties": {
                "enabled": {
                  "const": false
                },
                "mode": {
                  "enum": [
                    "iframe",
                    "none",
                    "shadow"
                  ]
                },
                "position": {
                  "enum": [
                    "character.sheet.side",
                    "room.chat.aboveHistory",
                    "room.rail.right",
                    "room.stage.primary",
                    "room.tab",
                    "settings.section"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        },
        "content_packs": {
          "type": "object",
          "properties": {
            "dirs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9._\\-/]+$",
                "description": "插件内的相对路径；不允许绝对路径、盘符或 .."
              }
            },
            "contract_version": {
              "const": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
