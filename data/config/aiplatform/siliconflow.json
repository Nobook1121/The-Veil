{
  "platform": "siliconflow",
  "name": "硅基流动",
  "description": "硅基流动AI模型服务平台",
  "icon": "/assets/aiplatform/siliconflow.png",
  "enabled": false,
  "config": {
    "base_url": "https://api.siliconflow.cn/v1",
    "headers": {
      "Content-Type": "application/json"
    },
    "timeout": 30,
    "provider_type": "openai-compatible",
    "base_url_full": false,
    "default_model": "gpt-4-turbo"
  },
  "models": [
    {
      "id": "gpt-4-turbo",
      "name": "GPT-4 Turbo",
      "description": "OpenAI的GPT-4 Turbo模型",
      "enabled": true,
      "params": {
        "context_window": 128000,
        "max_tokens": 4096,
        "temperature": 0.7,
        "top_p": 0.95
      }
    }
  ],
  "order": 2
}
