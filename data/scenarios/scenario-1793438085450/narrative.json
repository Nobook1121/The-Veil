    {
      "id": "porch",
      "kind": "location",
      "title": "门厅",
      "parent": "area_upper",
      "order": 0,
      "summary": "灰垣宅的门厅。邮件堆与旧提灯都在这里。",
      "body": "门厅不大，墙边立着伞架，衣帽架上挂着一盏旧提灯。地板上散着一叠没有拆开的邮件，最上面一封的收件人写着“灰垣宅·管家收”。\n\n管家霍尔特站在楼梯口，左手藏在袖子里。",
      "body_ref": {},
      "scene_role": "stage",
      "access": "free",
      "repeatable": true,
      "beats": [],
      "objects": [
        {
          "id": "obj_mail",
          "name": "邮件堆",
          "summary": "一叠被雨水打湿的邮件，最下面压着几页账本。",
          "visible": true,
          "visibility": "public",
          "interactions": [
            {
              "id": "interact_mail",
              "skill": "侦查",
              "difficulty": "regular",
              "repeatable": true,
              "outcomes": {
                "success": {
                  "text": "你从邮件堆底部抽出几页账本，上面反复写着“地下室·食料·一份”。",
                  "effects": {
                    "clue": [
                      "clue_butler_ledger"
                    ],
                    "flags": {
                      "butler_trust": false
                    }
                  }
                },
                "fail": {
                  "text": "邮件太多，你只翻出几封无关紧要的账单。"
                }
              }
            }
          ]
        },
        {
          "id": "obj_lantern",
          "name": "旧提灯",
          "summary": "衣帽架上的旧提灯，灯罩内侧刻着“给艾琳”。",
          "visible": true,
          "visibility": "public",
          "interactions": [
            {
              "id": "interact_lantern",
              "repeatable": true,
              "outcomes": {
                "success": {
                  "text": "你点亮提灯，暖黄色灯光照亮了门厅角落的泥脚印。",
                  "effects": {
                    "items": {
                      "old_lantern": "add"
                    },
                    "flags": {
                      "has_lantern": true
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      "completion": null,
