    {
      "id": "library",
      "kind": "location",
      "title": "图书馆",
      "parent": "area_upper",
      "order": 0,
      "summary": "高窗、旧书与红木书桌。妹妹被反锁在书架后的暗格里。",
      "body": "图书馆的窗帘只拉开一半，雨水在玻璃上留下细长的痕。红木书桌靠墙摆放，抽屉半开，里面散落着票据和一把黄铜钥匙。\n\n书架后传来轻轻的敲击声。",
      "body_ref": {},
      "scene_role": "room",
      "access": "free",
      "repeatable": true,
      "beats": [],
      "objects": [
        {
          "id": "obj_desk",
          "name": "红木书桌",
          "summary": "抽屉半开，夹层里似乎藏着东西。",
          "visible": true,
          "visibility": "public",
          "interactions": [
            {
              "id": "interact_desk_search",
              "skill": "侦查",
              "difficulty": "regular",
              "repeatable": true,
              "outcomes": {
                "success": {
                  "text": "你撬开夹层，找到一本皮面日记和一把黄铜钥匙。书桌后方的墙板发出空洞的回声。",
                  "effects": {
                    "clue": [
                      "clue_diary"
                    ],
                    "items": {
                      "brass_key": "add"
                    },
                    "flags": {
                      "has_key": true
                    }
                  }
                },
                "fail": {
                  "text": "抽屉卡住了。你只翻出一叠无用的账单，夹层仍然紧闭。"
                }
              }
            }
          ]
        }
      ],
      "completion": null,
