    {
      "id": "cellar",
      "kind": "location",
      "title": "地窖",
      "parent": "area_lower",
      "order": 0,
      "summary": "潮湿的石阶通向地窖，一具穿礼服的尸体靠墙坐着。",
      "body": "石阶尽头是地窖。墙角的尸体靠墙坐着，礼服前襟被撕开，胸口刻着一个裂隙符号。潮湿的空气里有铁锈味。\n\n内门后传来低低的数数声。",
      "body_ref": {},
      "scene_role": "room",
      "access": "gated",
      "repeatable": true,
      "beats": [],
      "objects": [
        {
          "id": "obj_corpse",
          "name": "尸体",
          "summary": "穿礼服的男性尸体，胸口刻着裂隙符号。",
          "visible": true,
          "visibility": "public",
          "interactions": [
            {
              "id": "interact_corpse_search",
              "skill": "侦查",
              "difficulty": "regular",
              "repeatable": true,
              "outcomes": {
                "success": {
                  "text": "你在尸体怀里摸到一封潮湿的信。信纸边缘写着“第四次之后，门就不再需要钥匙”。",
                  "effects": {
                    "clue": [
                      "clue_cultist_letter"
                    ],
                    "clocks": {
                      "doom_clock": {
                        "delta": 1
                      }
                    }
                  }
                },
                "fail": {
                  "text": "你翻动尸体时只闻到更浓的铁锈味，没有找到有用的东西。"
                }
              }
            }
          ]
        }
      ],
