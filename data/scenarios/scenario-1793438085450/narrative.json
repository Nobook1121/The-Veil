    {
      "id": "ritual",
      "kind": "location",
      "title": "祭坛室",
      "parent": "area_lower",
      "order": 0,
      "summary": "黑石祭坛、银匕首与正在扩张的裂隙。",
      "body": "祭坛室比地窖更低。黑石祭坛立在房间中央，表面刻满细密的符号；裂隙在墙面渗出微光，像一只缓慢睁开的眼睛。\n\n祭坛中央摆着一把银匕首。",
      "body_ref": {},
      "scene_role": "room",
      "access": "free",
      "repeatable": true,
      "beats": [],
      "objects": [
        {
          "id": "obj_altar",
          "name": "黑石祭坛",
          "summary": "祭坛背面刻着封印仪式的图样。",
          "visible": true,
          "visibility": "public",
          "interactions": [
            {
              "id": "interact_altar_study",
              "skill": "神秘学",
              "difficulty": "regular",
              "repeatable": true,
              "outcomes": {
                "success": {
                  "text": "你辨认出祭坛背面的图样：银匕首必须由读过图的人握住，才能封住裂隙。",
                  "effects": {
                    "clue": [
                      "clue_ritual_diagram"
                    ],
                    "clocks": {
                      "doom_clock": {
                        "delta": 1
                      }
                    }
                  }
                },
                "fail": {
                  "text": "符号在你眼里不断游动，你只记住了一个“四”字。"
                }
              }
            },
            {
              "id": "interact_altar_perform",
              "skill": "神秘学",
              "difficulty": "hard",
              "repeatable": false,
              "outcomes": {
                "success": {
                  "text": "你把银匕首按在祭坛中央，符号逐一亮起。裂隙的扩张停了一瞬。",
                  "effects": {
                    "flags": {
                      "altar_ready": true
                    },
                    "clocks": {
                      "doom_clock": {
                        "delta": 1
                      }
                    }
                  }
                },
                "fail": {
                  "text": "仪式没有完成。祭坛上的符号亮了又灭，裂隙仍在扩张。",
                  "effects": {
                    "clocks": {
                      "doom_clock": {
                        "delta": 1
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "id": "obj_dagger",
          "name": "银匕首",
          "summary": "没有开刃的银匕首，刀柄刻着裂隙符号。",
          "visible": true,
          "visibility": "hidden",
          "reveal_when": {
            "clue": "clue_ritual_diagram"
          },
          "interactions": [
            {
              "id": "interact_take_dagger",
              "repeatable": false,
              "outcomes": {
                "success": {
                  "text": "你握住银匕首。刀柄冰凉，裂隙的光在刀身上停了一瞬。",
                  "effects": {
                    "items": {
                      "silver_dagger": "add"
                    },
                    "flags": {
                      "has_dagger": true
                    },
                    "clocks": {
                      "doom_clock": {
                        "delta": 1
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      ],
