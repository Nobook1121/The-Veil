{
  "schema_version": 1,
  "id": "dnd5e",
  "name": "D&D 5e 规则集",
  "version": "0.1.0",
  "description": "D&D 5e（SRD 5.1）规则集插件：5e 角色卡、属性检定与豁免、canvas workspace 声明。内容数据由 dnd5e-srd 提供。",
  "author": "The Veil",
  "api_version": 1,
  "requires": {
    "plugins": {
      "dnd5e-srd": ">=1.0.0"
    }
  },
  "code": {
    "entry": "entry.py"
  },
  "capabilities": {
    "rulesets": {
      "module": "entry.py",
      "ids": ["dnd5e"]
    },
    "ui": {
      "api_version": 1,
      "workspace": {
        "layout_id": "dnd5e-canvas",
        "rulesets": ["dnd5e"],
        "primary": "canvas",
        "primary_min_width": 720,
        "sidebar": {
          "position": "right",
          "width": 380,
          "min_width": 360,
          "max_width": 420,
          "collapsible": true,
          "collapsed_width": 48
        },
        "topbar": {
          "height": 48,
          "slots": ["scene", "players", "turn", "status", "settings"]
        },
        "left_rail": {
          "width": 48,
          "visible": true
        },
        "panels": {
          "chat": "sidebar",
          "character": "drawer",
          "combat": "topbar"
        },
        "priority": 100
      }
    }
  }
}
