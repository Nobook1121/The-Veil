{
  "schema_version": 1,
  "id": "dnd5e-vtt",
  "name": "D&D 5e 战桌",
  "version": "0.3.0",
  "description": "D&D 5e 战桌 UI：右侧栏六面板 + 画布左上工具组（模板/测距尺，仅 DM 可编辑）+ 棋子操作卡 + 地图骰桌（掷骰落在地图上播 3D 骰子动画与结果飘字，nat20/nat1 高亮；DM 可关动画与调骰数上限，底栏 d20 dock 全员快捷掷骰）。模板与骰桌设置走房间级端点（幂等/四态回执）并 socket 广播；地图落点与棋子目录读 veil-map 公开载荷，dice3d bundle 按需注入不重编译；聊天掷骰卡管线零改动。",
  "author": "The Veil",
  "api_version": 1,
  "requires": {
    "plugins": {
      "dnd5e": ">=0.1.0"
    }
  },
  "code": {
    "entry": "entry.py"
  },
  "capabilities": {
    "http_blueprints": {
      "module": "entry.py",
      "blueprints": ["bp"]
    },
    "agent_tools": {
      "module": "agent_tools.py",
      "tools": [
        "dnd5e-vtt.place_template",
        "dnd5e-vtt.switch_scene",
        "dnd5e-vtt.roll_broadcast",
        "dnd5e-vtt.worldtree_recall"
      ]
    },
    "ui": {
      "api_version": 1,
      "slots": [
        {
          "id": "dnd5e-vtt-rail",
          "slot": "room.rail.right",
          "title_i18n": "dnd5e_vtt.rail_title",
          "rulesets": ["dnd5e"],
          "requires": [],
          "priority": 100,
          "layout": {
            "desktop": "fill"
          },
          "permissions": [
            "room.read"
          ],
          "mount": "mountRail"
        }
      ]
    },
    "frontend_assets": [
      {
        "path": "ui/dnd5e-vtt.js",
        "type": "script"
      },
      {
        "path": "ui/dnd5e-vtt.css",
        "type": "style"
      }
    ]
  }
}
