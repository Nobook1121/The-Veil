{
  "schema_version": 1,
  "id": "dnd5e-vtt",
  "name": "D&D 5e 战桌",
  "version": "0.2.0",
  "description": "D&D 5e 战桌 UI：右侧栏六面板（聊天/战斗/场景/角色/物品/日志）+ 画布左上工具组（选择/测距尺/测量模板圆锥线方+清空，仅 DM 可编辑）+ 棋子操作卡（DM 拉动作清单，玩家响应不含操作按钮）。模板走房间级登记端点（request_id 幂等）并广播全员只读展示；空间几何复用 veil-map 公开端点，锥/方按本地几何近似。布局沿用 dnd5e 规则集声明的 dnd5e-canvas。",
  "author": "The Veil",
  "api_version": 1,
  "requires": {
    "plugins": {
      "dnd5e": ">=0.1.0"
    }
  },
  "code": {
    "entry": "entry.py"
  },
  "capabilities": {
    "http_blueprints": {
      "module": "entry.py",
      "blueprints": ["bp"]
    },
    "ui": {
      "api_version": 1,
      "slots": [
        {
          "id": "dnd5e-vtt-rail",
          "slot": "room.rail.right",
          "title_i18n": "dnd5e_vtt.rail_title",
          "rulesets": ["dnd5e"],
          "requires": [],
          "priority": 100,
          "layout": {
            "desktop": "fill"
          },
          "permissions": [
            "room.read"
          ],
          "mount": "mountRail"
        }
      ]
    },
    "frontend_assets": [
      {
        "path": "ui/dnd5e-vtt.js",
        "type": "script"
      },
      {
        "path": "ui/dnd5e-vtt.css",
        "type": "style"
      }
    ]
  }
}
